{
  "name": "tou-rent",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "vp config --no-agent",
    "build": "turbo build",
    "codegen": "turbo codegen",
    "dev": "turbo dev",
    "stack:up": "vp run rust:check && podman compose -f infra/compose/docker-compose.dev.yml --profile api up -d",
    "stack:up:only": "podman compose -f infra/compose/docker-compose.dev.yml --profile api up -d",
    "stack:down": "podman compose -f infra/compose/docker-compose.dev.yml --profile api down",
    "api:restart": "podman compose -f infra/compose/docker-compose.dev.yml restart api",
    "api:logs": "podman compose -f infra/compose/docker-compose.dev.yml logs -f api",
    "api:migrate": "podman compose -f infra/compose/docker-compose.dev.yml run --rm api-migrate",
    "api:seed": "podman compose -f infra/compose/docker-compose.dev.yml --profile api run --rm --no-deps -e SQLX_OFFLINE=true -e SEED_PASSWORD api cargo run -q -p api -- seed",
    "cache:size": "podman run --rm -v tou-rent-target:/target alpine:3.24.3 du -sh /target /target/debug/deps /target/debug/incremental",
    "cache:sweep": "podman run --rm -v tou-rent-target:/target alpine:3.24.3 rm -rf /target/debug/incremental",
    "cache:clean": "podman run --rm -v tou-rent-target:/target alpine:3.24.3 sh -c \"rm -rf /target/debug /target/release\"",
    "zitadel:up": "podman compose -f infra/compose/docker-compose.dev.yml --profile zitadel up -d",
    "zitadel:down": "podman compose -f infra/compose/docker-compose.dev.yml --profile zitadel down",
    "zitadel:provision": "podman compose -f infra/compose/docker-compose.dev.yml run --rm zitadel-init",
    "zitadel:logs": "podman compose -f infra/compose/docker-compose.dev.yml logs -f zitadel zitadel-login zitadel-init",
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt --write",
    "gates": "sh infra/scripts/gates.sh",
    "gates:all": "sh infra/scripts/gates.sh --all",
    "rust:check": "sh infra/scripts/rust-gate.sh check",
    "rust:fmt": "sh infra/scripts/rust-gate.sh fmt",
    "rust:lint": "sh infra/scripts/rust-gate.sh lint",
    "rust:test": "podman compose -f infra/compose/docker-compose.dev.yml --profile api run --rm api cargo test --workspace",
    "verify": "vp run gates && vp check && vp run rust:lint",
    "e2e": "bun run --cwd apps/e2e e2e",
    "e2e:install": "bun run --cwd apps/e2e e2e:install"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.11.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5",
    "typescript": "7.0.2"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:",
    "typescript": "catalog:",
    "js-yaml": "^4.3.1",
    "nanoid": "3.3.18",
    "solid-js": "1.9.17"
  }
}
