  "query": "SELECT t.id, t.title, t.title_kk, t.status::text AS \"status!\", t.created_at,\n                  (SELECT count(*) FROM core.applications a WHERE a.tender_id = t.id)\n                    AS \"applications!\"\n           FROM core.tenders t\n           ORDER BY t.id DESC\n           LIMIT $1",
