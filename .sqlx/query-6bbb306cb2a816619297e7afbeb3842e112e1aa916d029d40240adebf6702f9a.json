  "query": "SELECT p.id, p.tender_id, t.title AS tender_title,\n                      p.kind::text AS \"kind!\", p.number, p.pdf_key, p.generated_at,\n                      p.published_at, p.unpublish_at, p.unpublished_at\n               FROM core.protocols p\n               JOIN core.tenders t ON t.id = p.tender_id WHERE p.tender_id = $1 ORDER BY p.generated_at DESC",
