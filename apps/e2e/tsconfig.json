{
  "include": ["**/*.ts"],
  "compilerOptions": {
    "target": "esnext",
    "module": "ESNext",
    "lib": ["ESNext"],
    "types": ["node"],

    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true
  }
}
