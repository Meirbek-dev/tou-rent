{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vp dev\"",
    "dev:alt": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vp dev --port 3105\"",
    "generate-routes": "tsr generate",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "build": "vp build && bun build ./instrument.server.mjs --target=bun --outfile .output/server/instrument.server.mjs",
    "preview": "vp preview",
    "start": "bun --preload ./.output/server/instrument.server.mjs .output/server/index.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@posthog/react": "^1.11.3",
    "@sentry/tanstackstart-react": "^11.9.0",
    "@shadcn/react": "^0.3.1",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/match-sorter-utils": "^9.2.6",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.22",
    "@tanstack/store": "^0.11.2",
    "@tou/api-client": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.3",
    "input-otp": "^1.5.0",
    "lucide-react": "1.61.0",
    "nitro": "3.0.260903-beta",
    "posthog-js": "^1.438.21",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.0",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@inlang/paraglide-js": "^2.29.1",
    "@neodrag/core": "3.0.0-next.12",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/devtools-event-client": "^0.5.0",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.167.46",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv-cli": "^11.0.0",
