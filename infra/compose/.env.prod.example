# Переменные прод-стенда (NFR-09: реальные значения в репозиторий не попадают -
# копия этого файла в .env рядом с docker-compose.prod.yml, права 600).

# Домен и почта для ACME-сертификата Let's Encrypt
TOU_DOMAIN=rent.tou.edu.kz
ACME_EMAIL=ops@tou.edu.kz

# Стенд за чужим фронтом. Нужно только там, где 80 и 443 занял другой сервис:
# порты публикации уезжают на свободные, Caddy отдает голый HTTP (сертификат
# на других портах ACME не выпустит - его берет на себя фронт), а адрес
# клиента приходит в X-Forwarded-For, и доверять ему можно только с адресов
# самого фронта - иначе заголовок подделает кто угодно и обнулит себе лимит
# попыток входа (NFR-09). Подсеть - та, из которой фронт ходит в этот стенд
# HTTP_PORT=8081
# HTTPS_PORT=8444
# SITE_SCHEME=http://
# TRUSTED_PROXIES=172.16.0.0/12

# Источники, которым разрешено открывать сокет комнаты торгов (через запятую).
# По умолчанию - https://$TOU_DOMAIN, то есть свой origin, и правки не требует.
# Задавать вручную нужно в двух случаях: стенд за чужим фронтом отдает голый
# HTTP (SITE_SCHEME=http:// - тогда и схема здесь http://), либо у стенда
# несколько имен. Пустое значение выключает проверку целиком - api скажет
# об этом предупреждением в журнале старта; на нее и держится защита от
# чужой страницы, открывающей сокет с чужой сессией (NFR-09)
# WS_ALLOWED_ORIGINS=https://rent.tou.edu.kz

# Container Registry и версия релиза (тег ставит CI). Стенд можно держать
# и без реестра вовсе: `REGISTRY=localhost/tou-rent`, свой тег вместо latest
# и `DEPLOY_BUILD=1 ./deploy.sh` - образы api и web соберутся на самом хосте
# REGISTRY=git.tou.edu.kz/tou-rent
# TAG=latest
REGISTRY=localhost/tou-rent
TAG=v1

# Секреты стенда
POSTGRES_PASSWORD=
# Пароль Redis: в нем лежат сессии и счетчики попыток входа, а сеть стенда
# общая. Значение попадает в URL подключения - используйте только буквы
# и цифры: `@`, `/`, `:` и `#` разберутся как части адреса
REDIS_PASSWORD=
# Root-ключи RustFS: ими ходят только шаги провижининга (создают бакеты,
# Object Lock и учетную запись приложения). Приложению они не выдаются
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Учетная запись приложения: чтение и запись объектов. В бакете досье нет
# и права на удаление объекта - там WORM, удалять нечего и незачем;
# бакет и Object Lock ей тем более неподвластны (INV-042, NFR-09)
S3_APP_ACCESS_KEY=
S3_APP_SECRET_KEY=
# Мастер-ключ шифрования ценовых предложений (INV-040, п. 40). В базе не
# хранится: без него цены не читаются и не записываются - храните копию
# отдельно от дампов БД, иначе шифрование теряет смысл
PRICE_ENCRYPTION_KEY=

# Подтверждение регистрации. Настройте SMTP, SMS-шлюз либо оба канала.
# VERIFICATION_LOG_CODES в проде намеренно не поддерживается compose-файлом.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@rent.tou.edu.kz
SMTP_STARTTLS=1
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# Пароль seed-аккаунтов (нужен только при первом наполнении: api seed)
SEED_PASSWORD=

# Очистка данных из кабинета админа (вкладка «Данные»): стенд, наполненный
# `api seed` под демонстрацию, возвращается в пустое состояние - тендеры,
# объекты, заявки, протоколы, торги, договоры и книга проводок стираются
# одной транзакцией со следом в аудите. Учетные записи, роли, состав
# комиссии, справочники и сам журнал аудита остаются.
# Задайте `1` на окно очистки, выполните ее и уберите строку (перезапуск
# api: ./deploy.sh). На рабочем стенде переменная не задается: протоколы
# и досье append-only, и стирать их не должен никто
# ALLOW_DATA_PURGE=1

# Провайдер идентичности (FR-1502, ADR-0003). Пусто - вход остается локальным
# (email+пароль, FR-1501): это же и якорь отката при недоступном провайдере.
# Реквизиты клиента заводит администратор Zitadel один раз (те же шаги, что
# делает infra/zitadel/provision.sh на дев-стенде).
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=https://rent.tou.edu.kz/api/v1/auth/oidc/callback
OIDC_POST_LOGOUT_URL=https://rent.tou.edu.kz/
# Значение с пробелами - в кавычках: файл читают и compose, и человек
# через `. .env`, и без кавычек второй вариант ломается
OIDC_LABEL="учетную запись университета"
# Zitadel кладет в аудиторию id_token id проекта - перечислить здесь
OIDC_TRUSTED_AUDIENCES=

RUST_LOG=info
