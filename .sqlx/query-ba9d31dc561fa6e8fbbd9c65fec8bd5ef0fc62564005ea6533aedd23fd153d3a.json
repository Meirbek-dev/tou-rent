  "query": "SELECT u.id, u.email::text AS \"email!\", u.password_hash,\n                      u.full_name, u.locale,\n                      u.applicant_kind::text AS applicant_kind,\n                      u.id_number, u.phone, u.email_confirmed_at,\n                      u.phone_confirmed_at, u.is_active FROM core.user_identities i\n         JOIN core.users u ON u.id = i.user_id\n         WHERE i.issuer = $1 AND i.subject = $2",
