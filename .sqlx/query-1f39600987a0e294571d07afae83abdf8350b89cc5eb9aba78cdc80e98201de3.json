  "query": "SELECT o.id, o.name, o.name_kk, o.kind::text AS \"kind!\", o.area_m2, o.created_at,\n                  (SELECT count(DISTINCT lo.tender_id) FROM core.lots lo WHERE lo.object_id = o.id)\n                    AS \"tenders!\"\n           FROM core.objects o\n           ORDER BY o.id DESC\n           LIMIT $1",
