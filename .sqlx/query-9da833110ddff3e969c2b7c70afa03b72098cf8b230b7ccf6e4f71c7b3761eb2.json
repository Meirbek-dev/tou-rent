  "query": "SELECT id, kind::text AS \"kind!\", special_request_id, contract_id,\n                      acceptance_id, title, file_key, payload, published_at,\n                      unpublish_at, unpublished_at\n               FROM core.public_records WHERE unpublished_at IS NULL\n            AND ($1::timestamptz IS NULL OR (published_at, id) < ($1, $2::uuid))\n          ORDER BY published_at DESC, id DESC LIMIT $3",
