{
  "db_name": "PostgreSQL",
  "query": "SELECT p.id, p.tender_id, t.title AS tender_title,\n                      p.kind::text AS \"kind!\", p.number, p.pdf_key, p.generated_at,\n                      p.published_at, p.unpublish_at, p.unpublished_at\n               FROM core.protocols p\n               JOIN core.tenders t ON t.id = p.tender_id WHERE EXISTS (SELECT 1 FROM core.applications a\n                        WHERE a.tender_id = p.tender_id AND a.participant_id = $1)\n            AND ($2::uuid IS NULL\n                 OR (p.generated_at, p.id)\n                    < (SELECT generated_at, id FROM core.protocols WHERE id = $2))\n          ORDER BY p.generated_at DESC, p.id DESC LIMIT $3",
