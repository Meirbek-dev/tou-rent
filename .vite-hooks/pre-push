#!/bin/sh
# Вторая линия лазеров перед пушем (первая - vp staged в pre-commit, третья - CI-гейты).
#
# Rust здесь больше не пропускается. Раньше стояла оговорка «на Windows-хосте
# не гоняем - закроет CI (A-003)», и она означала вот что: ошибку компиляции
# или запрещенный unwrap разработчик узнавал либо из логов контейнера после
# `vp run stack:up`, либо из пайплайна через несколько минут после пуша.
# Теперь cargo запускается в том же контейнере, что и сервис api, на общем
# кеше - проверка стоит секунды и идет до пуша (infra/scripts/rust-gate.sh).
#
# Погасить лазеры разово: VP_GIT_HOOKS=0 git push
set -e

sh infra/scripts/gates.sh
vp check

# Rust-часть требует podman. Он не отвечает - хук красный: пропустить
# проверку молча нельзя, иначе оговорка возвращается на прежнее место.
# Осознанный пропуск делается явно: TOU_SKIP_RUST=1 git push
if [ "${TOU_SKIP_RUST:-0}" = "1" ]; then
  echo "pre-push: Rust-гейты пропущены по TOU_SKIP_RUST=1" >&2
else
  sh infra/scripts/rust-gate.sh lint
fi
