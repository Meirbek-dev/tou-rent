  "query": "SELECT b.id, b.auction_id, b.application_id,\n                      COALESCE(app.applicant_details->>'name', '-') AS \"applicant_name!\",\n                      b.amount, b.seq, b.placed_at\n               FROM core.bids b\n               JOIN core.applications app ON app.id = b.application_id WHERE b.id = $1 AND b.auction_id = $2 AND b.application_id = $3",
