{
  "db_name": "PostgreSQL",
  "query": "SELECT a.id, a.tender_id, a.lot_id, a.participant_id,\n                      a.status::text AS \"status!\",\n                      a.applicant_kind::text AS \"applicant_kind!\",\n                      a.applicant_details, a.qualification, a.submitted_at,\n                      a.withdrawn_at, a.rejection_reason,\n                      core.price_amount(p) AS price_amount\n               FROM core.applications a\n               LEFT JOIN core.price_proposals p ON p.application_id = a.id WHERE a.tender_id = $1 ORDER BY a.submitted_at",
