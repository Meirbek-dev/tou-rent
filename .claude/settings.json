{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh infra/scripts/hook-post-edit.sh",
            "timeout": 120,
            "statusMessage": "Проверка типов и линта"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh infra/scripts/hook-stop.sh",
            "timeout": 600,
            "statusMessage": "Гейты проекта"
          }
        ]
      }
    ]
  }
}
